{
  "name": "react-treecraft",
  "version": "0.2.0",
  "description": "A headless, minimal, and highly customizable tree structure builder for React. Zero assumptions. Full control.",
  "author": "Selahadin Hamid",
  "license": "MIT",
  "keywords": [
    "react",
    "tree",
    "tree-view",
    "tree-component",
    "hierarchy",
    "hierarchical",
    "org-chart",
    "organization-chart",
    "mind-map",
    "decision-tree",
    "file-tree",
    "headless",
    "customizable",
    "canvas",
    "drag-and-drop",
    "zoom",
    "pan",
    "minimap",
    "search",
    "export",
    "svg",
    "png",
    "connector",
    "graph",
    "treecraft",
    "node",
    "typescript"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": "./dist/index.css",
    "./styles.css": "./dist/index.css",
    "./dist/index.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "dist/index.css",
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run test && npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^5.0.3"
  }
}
